<idea-plugin>
    <id>com.leko.forge</id>
    <name>Forge</name>
    <vendor>Leko</vendor>
    <description><![CDATA[
    Support for Forge, the compiler definition language (<code>.forge</code> files):
    <ul>
        <li>highlighting with the compiler's own lexer and parser: keywords, strings, regular expressions, numbers,
            comments, and names by their role (nodes, types, attributes, functions, parsers and rules, ...);</li>
        <li>the syntax errors of the compiler's parser while typing;</li>
        <li>the errors and warnings of the compiler's analysis (types, attributes, cycles, flows, imports, ...)
            where the compiler reports them;</li>
        <li>navigation (Ctrl+Click, Go to Declaration) and Find Usages, as the compiler resolves the names, also into
            imported files and the standard library; attributes and vals, which are computed, are italic;</li>
        <li>gutter icons for implementations and overrides (nodes and interface nodes, syn and circular attributes,
            inh equations, parser rules); Find Usages of a definition includes its implementations;</li>
        <li>documentation on hover (Ctrl+Q): signature, doc comment, kind, type and hierarchy;</li>
        <li>code completion: the members the compiler resolves after <code>.</code> (fields, attributes, vals, methods,
            enum constants, rules), locals, declarations, types and keywords;</li>
        <li>folding of declaration bodies, blocks, block comments and imports;</li>
        <li>a run configuration that compiles a .forge file with the compiler of the plugin (right click | Run, or the
            run icon in the gutter), with links from the compiler's messages to the code;</li>
        <li>a project wizard (File | New | Project... | Forge): a sample or empty program, the target language, and a
            Gradle build that runs the bundled compiler and, for Kotlin, runs the generated code;</li>
        <li>brace matching, commenting and quote pairing.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- the project wizard imports the Gradle build of a new project -->
    <depends optional="true" config-file="forge-gradle.xml">com.intellij.gradle</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="com.leko.forge.gradleLinker"
                        interface="com.leko.forge.intellij.wizard.ForgeGradleLinker" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <newProjectWizard.generator implementation="com.leko.forge.intellij.wizard.ForgeNewProjectWizard"/>
        <postStartupActivity implementation="com.leko.forge.intellij.wizard.ForgeNewProjectActivity"/>
        <fileType name="Forge" language="Forge" extensions="forge" fieldName="INSTANCE"
                  implementationClass="com.leko.forge.intellij.ForgeFileType"/>
        <lang.parserDefinition language="Forge"
                               implementationClass="com.leko.forge.intellij.parser.ForgeParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Forge"
                                       implementationClass="com.leko.forge.intellij.highlight.ForgeSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.leko.forge.intellij.highlight.ForgeColorSettingsPage"/>
        <annotator language="Forge" implementationClass="com.leko.forge.intellij.highlight.ForgeAnnotator"/>
        <externalAnnotator language="Forge"
                           implementationClass="com.leko.forge.intellij.annotator.ForgeCompilerAnnotator"/>
        <lang.braceMatcher language="Forge" implementationClass="com.leko.forge.intellij.editor.ForgeBraceMatcher"/>
        <lang.commenter language="Forge" implementationClass="com.leko.forge.intellij.editor.ForgeCommenter"/>
        <lang.quoteHandler language="Forge" implementationClass="com.leko.forge.intellij.editor.ForgeQuoteHandler"/>
        <lang.findUsagesProvider language="Forge"
                                 implementationClass="com.leko.forge.intellij.psi.ForgeFindUsagesProvider"/>
        <renamePsiElementProcessor implementation="com.leko.forge.intellij.hierarchy.ForgeRenameProcessor"/>
        <lang.namesValidator language="Forge" implementationClass="com.leko.forge.intellij.hierarchy.ForgeNamesValidator"/>
        <lang.elementManipulator forClass="com.leko.forge.intellij.psi.ForgeImportPath"
                                 implementationClass="com.leko.forge.intellij.psi.ForgeImportPathManipulator"/>
        <configurationType implementation="com.leko.forge.intellij.run.ForgeConfigurationType"/>
        <runConfigurationProducer implementation="com.leko.forge.intellij.run.ForgeRunConfigurationProducer"/>
        <runLineMarkerContributor language="Forge" implementationClass="com.leko.forge.intellij.run.ForgeRunLineMarkerContributor"/>
        <findUsagesHandlerFactory implementation="com.leko.forge.intellij.hierarchy.ForgeFindUsagesHandlerFactory"/>
        <codeInsight.lineMarkerProvider language="Forge"
                                        implementationClass="com.leko.forge.intellij.hierarchy.ForgeLineMarkerProvider"/>
        <completion.contributor language="Forge"
                                implementationClass="com.leko.forge.intellij.completion.ForgeCompletionContributor"/>
        <typedHandler implementation="com.leko.forge.intellij.completion.ForgeTypedHandler"/>
        <lang.formatter language="Forge" implementationClass="com.leko.forge.intellij.format.ForgeFormattingModelBuilder"/>
        <lang.foldingBuilder language="Forge" implementationClass="com.leko.forge.intellij.editor.ForgeFoldingBuilder"/>
        <lang.documentationProvider language="Forge"
                                    implementationClass="com.leko.forge.intellij.editor.ForgeDocumentationProvider"/>
    </extensions>
</idea-plugin>
