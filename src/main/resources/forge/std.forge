// std.forge: the standard library of Forge. It is bundled with the compiler and part of every program.
//
// The `ext fun`s and `ext val`s are implemented by the runtime of every target; the other functions are Forge
// code, generated into a compiler only if it uses them. All are methods or properties (except `char` and `fail`),
// and a program that declares one with the same receiver and name uses its own.
//
// Part of the language rather than of this file: the operators (`++`, `in`, `xs[i]`, `xs[a:b]`, ...) and the
// graph declarations (`Graph`, `Edge`, `Vertex`, `graphOf`, `Span`, `spanOf`).

// ---- builtins ------------------------------------------------------------------------------------------

/** Stops with an error; of type Nothing, so it fits wherever a value is expected: `x ?: fail("missing")`. */
ext fun fail(message: str): Nothing
/** The character with a code, as a str. */
ext fun char(code: int): str

/** As text; floats like Kotlin's `Float.toString`. */
ext fun int.str(): str
ext fun float.str(): str
ext fun bool.str(): str

/** The number of characters: UTF-16 code units in Kotlin and Java, code points in Python, bytes elsewhere. */
ext val str.size: int
/** The number the whole text is; fails otherwise. */
ext fun str.toInt(): int
ext fun str.toFloat(): float
/** Where [part] first occurs; -1 if it does not. */
ext fun str.indexOf(part: str): int
ext fun str.startsWith(prefix: str): bool
ext fun str.endsWith(suffix: str): bool
/** Every occurrence of [old] replaced by [replacement]. */
ext fun str.replace(old: str, replacement: str): str
ext fun str.upper(): str
ext fun str.lower(): str
/** Without whitespace at the start and the end. */
ext fun str.trim(): str
ext fun str.split(separator: str): List<str>
/** The code of the character at [index]. */
ext fun str.code(index: int): int
/** The bytes of the UTF-8 encoding. */
ext fun str.utf8(): List<int>
/** With escapes replaced: `\n`, `\t`, `\r`, `\0`; `\x` is x for any other character. */
ext fun str.unescape(): str

/** The number of elements, entries. */
ext val <T> List<T>.size: int
ext val <T> Set<T>.size: int
ext val <K, V> Map<K, V>.size: int

/** Where [x] first is; -1 if it is not. */
ext fun <T> List<T>.indexOf(x: T): int
ext fun <T> List<T>.reversed(): List<T>
ext fun <T> List<T>.toSet(): Set<T>
ext fun List<str>.join(separator: str): str

/** The elements in the order they were added. */
ext fun <T> Set<T>.toList(): List<T>
ext fun <T> Set<T>.remove(x: T): Set<T>

/** The keys and the values, in the order of the map. */
ext fun <K, V> Map<K, V>.keys(): List<K>
ext fun <K, V> Map<K, V>.values(): List<V>
ext fun <K, V> Map<K, V>.remove(key: K): Map<K, V>

// ---- lists as sets: the order of the elements is kept, no element is added twice --------------------

/** The elements of this list, then those of [other] that it does not contain. */
fun <T> List<T>.union(other: List<T>): List<T> = (if x in acc then acc else acc ++ [x]) for x in other with acc = this.distinct()

/** The elements of this list that [other] does not contain; also `xs - ys`. */
op fun <T> List<T>.minus(other: List<T>): List<T> = (if x in other then acc else acc ++ [x]) for x in this with acc = []

/** The elements without duplicates, each where it first occurs. */
fun <T> List<T>.distinct(): List<T> = this.toSet().toList()

/** Whether the lists have no element in common. */
fun <T> List<T>.disjoint(other: List<T>): bool = (acc && !(x in other)) for x in this with acc = true

// ---- numbers -------------------------------------------------------------------------------------------

fun List<int>.sum(): int = acc + x for x in this with acc = 0
fun List<float>.sum(): float = acc + x for x in this with acc = 0.0

/** The largest element; fails for an empty list. */
fun List<int>.max(): int = match this {
    first :: rest -> (if x > acc then x else acc) for x in rest with acc = first
    _ -> fail("max of an empty list")
}
fun List<float>.max(): float = match this {
    first :: rest -> (if x > acc then x else acc) for x in rest with acc = first
    _ -> fail("max of an empty list")
}

/** The smallest element; fails for an empty list. */
fun List<int>.min(): int = match this {
    first :: rest -> (if x < acc then x else acc) for x in rest with acc = first
    _ -> fail("min of an empty list")
}
fun List<float>.min(): float = match this {
    first :: rest -> (if x < acc then x else acc) for x in rest with acc = first
    _ -> fail("min of an empty list")
}

fun int.max(other: int): int = if this > other then this else other
fun int.min(other: int): int = if this < other then this else other
fun float.max(other: float): float = if this > other then this else other
fun float.min(other: float): float = if this < other then this else other
fun int.abs(): int = if this < 0 then -this else this
